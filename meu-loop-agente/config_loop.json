{
  "agente": {
    "modelo": "deepseek-chat",
    "temperatura": 0.2
  },
  "verificacao": {
    "diretorio_de_trabalho": "..",
    "comandos": [
      "python -m pytest -q",
      "python -m ruff check ."
    ],
    "parar_no_primeiro_erro": true,
    "timeout_segundos": 900
  },
  "metrica": {
    "nome": "Divida de rastreabilidade dos indicadores",
    "unidade": "fracao de 0 a 1",
    "direcao": "menor_melhor",
    "comando": "python meu-loop-agente/medir_qualidade.py",
    "regex": "divida_rastreabilidade:\\s*([0-9]+(?:[.,][0-9]+)?)",
    "grupo": 1
  },
  "limites": {
    "max_iteracoes": 20,
    "rejeicoes_consecutivas": 5
  }
}
