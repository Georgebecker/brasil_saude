# ---- Ambiente e segredos ----
# .env NUNCA pode ir para o git (regra de ouro): guarda chaves, senhas e caminhos.
.env
.env.*
!.env.example
.venv/
venv/

# ---- Dados (nunca versionar dados) ----
data/raw/*
data/processed/*
data/descartados/*
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/descartados/.gitkeep
data/.auth_secret
data/backups/
*.parquet
*.jsonl
*.sqlite
*.db

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# ---- Saídas e logs ----
saidas/
logs/
*.log

# ---- IDE / SO ----
.vscode/
.idea/
.DS_Store
Thumbs.db

# ---- Qualidade e cobertura ----
.coverage
coverage.xml
htmlcov/
.ruff_cache/

# ---- Front-end (caso use Node) ----
node_modules/

# ---- Relatórios gerados pelo agente do Loop ----
meu-loop-agente/outputs/*
!meu-loop-agente/outputs/.gitkeep

# estado e log do vigia da rede local (muda a cada ciclo)
data/rede/

