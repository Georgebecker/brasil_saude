# =========================================================
#  Brasil Saúde — variáveis de ambiente
#  Passo 1: copie este arquivo para `.env`
#  Passo 2: preencha com os valores do SEU ambiente
#  NUNCA envie o `.env` para o repositório (está no .gitignore)
#  Nenhuma chave real mora em arquivo: use a variável de
#  ambiente do usuário do Windows.
# =========================================================

# --- Projeto / caminhos ------------------------------------
PROJETO_NOME=brasil_saude
PASTA_RAIZ=.
PASTA_DADOS_RAW=data/raw
PASTA_DADOS_PROCESSED=data/processed
PASTA_NOTEBOOKS=notebooks
PASTA_SAIDAS=saidas

# --- Banco de dados (SQL) -----------------------------------
# SQLite (padrão, sem servidor):
DB_URL=sqlite:///data/brasil_saude.db
# PostgreSQL (exemplo):
# DB_URL=******localhost:5432/nome_do_banco
DB_ECHO=false

# --- Execução / qualidade -----------------------------------
LOG_NIVEL=INFO
SEMENTE_ALEATORIA=42

# --- APIs externas (opcionais — preencher só se for usar) ---
# DEEPSEEK_API_KEY=
# OPENAI_API_KEY=
# HF_TOKEN=